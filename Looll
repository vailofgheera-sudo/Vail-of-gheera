}
// ============ PRODUCT DETAIL MODAL (Enhanced) ============
const modalOverlay = document.getElementById('productModal');
const modalImg = document.getElementById('modalImg');
const modalThumbs = document.getElementById('modalThumbs');
const modalCat = document.getElementById('modalCat');
const modalTitle = document.getElementById('modalTitle');
const modalRating = document.getElementById('modalRating');
const modalPrice = document.getElementById('modalPrice');
const modalDesc = document.getElementById('modalDesc');
const modalSize = document.getElementById('modalSize');
const modalDetailsList = document.getElementById('modalDetailsList');
const modalShippingList = document.getElementById('modalShippingList');
const modalQtyVal = document.getElementById('modalQtyVal');
const modalQtyDec = document.getElementById('modalQtyDec');
const modalQtyInc = document.getElementById('modalQtyInc');
const modalAddBtn = document.getElementById('modalAddBtn');

let modalCurrentQty = 1;
let modalCurrentProductId = null;

function setModalImage(p, index){
const src = p.images[index] || p.images[0];
modalImg.innerHTML = `<img src="${src}" alt="${p.title}" decoding="async">`;
modalThumbs.querySelectorAll('.modal-thumb').forEach((t,i)=>t.classList.toggle('active', i===index));
}

function openProductModal(productId) {
const p = products.find(x => x.id === productId);
if (!p) return;
modalCurrentProductId = p.id;
modalCurrentQty = 1;
modalQtyVal.textContent = '1';

// Image + gallery
modalThumbs.innerHTML = p.images.length > 1
? p.images.map((src,i)=>`<button class="modal-thumb${i===0?' active':''}" data-index="${i}" aria-label="View image ${i+1}"><img src="${src}" alt="${p.title} view ${i+1}" loading="lazy" decoding="async"></button>`).join('')
: '';
modalThumbs.style.display = p.images.length > 1 ? 'flex' : 'none';
setModalImage(p, 0);
modalThumbs.querySelectorAll('.modal-thumb').forEach(btn=>{
btn.addEventListener('click', ()=> setModalImage(p, parseInt(btn.dataset.index)));
});

modalCat.textContent = catLabel(p.cat);
modalTitle.innerHTML = `${p.arabic?`<span class="arabic">${p.arabic}</span>`:''} ${p.title}`;
modalRating.innerHTML = `<span class="stars">★★★★★</span> ${p.rating} · In stock`;
modalPrice.innerHTML = `₹${p.price}${p.old?`<s>₹${p.old}</s>`:''}`;

// Description per category
const descMap = {
caps: 'A premium knitted prayer cap with fine embroidery that holds its shape wash after wash. Breathable, lightweight and comfortable for daily salah, travel and Jumu‘ah.',
bags: 'Spacious and durable school bag with premium Arabic embroidery. Designed to carry books and essentials with elegance.',
tote: 'Stylish 14×16 inch tote bag made from high-quality fabric. Perfect for daily use, shopping, or as a gift.',
tshirt: 'Comfortable cotton T-shirt with elegant Arabic embroidery. Available in multiple sizes, ideal for casual wear.'
};
modalDesc.textContent = descMap[p.cat] || 'Handcrafted with care and purpose.';

// Size
const sizeMap = {
caps: 'Free Size',
bags: 'Standard Size',
tote: '14×16 inches',
tshirt: 'S, M, L, XL, XXL'
};
modalSize.textContent = sizeMap[p.cat] || 'Standard Size';

// Product details (Material, Fit, Care)
const detailsMap = {
caps: [
{ label: 'Material', value: 'Cotton cap with resham embroidery' },
{ label: 'Fit', value: 'Free Size only' },
{ label: 'Care', value: 'Hand wash cold, reshape and dry flat' }
],
bags: [
{ label: 'Material', value: 'Durable polyester with premium zippers' },
{ label: 'Fit', value: 'Standard size with adjustable straps' },
{ label: 'Care', value: 'Spot clean with damp cloth' }
],
tote: [
{ label: 'Material', value: 'High-quality cotton canvas' },
{ label: 'Fit', value: '14×16 inches, sturdy handles' },
{ label: 'Care', value: 'Hand wash recommended' }
],
tshirt: [
{ label: 'Material', value: '100% combed cotton with screen-printed embroidery' },
{ label: 'Fit', value: 'Regular fit, available in S–XXL' },
{ label: 'Care', value: 'Machine wash cold, tumble dry low' }
]
};
const dets = detailsMap[p.cat] || detailsMap.caps;
modalDetailsList.innerHTML = dets.map(d => `<li><strong>${d.label}</strong> ${d.value}</li>`).join('');

// Shipping & returns
modalShippingList.innerHTML = `<li>Free delivery on orders above ₹999</li><li>Dispatched in 1–2 working days · delivered in 3–6 days</li><li>3‑day easy return or size exchange</li><li>Cash on delivery available across India (+10% extra)</li>`;

modalOverlay.classList.add('open');
document.body.style.overflow = 'hidden';
}

function closeProductModal() {
modalOverlay.classList.remove('open');
document.body.style.overflow = '';
}

document.getElementById('closeModal').addEventListener('click', closeProductModal);
modalOverlay.addEventListener('click', (e) => {
if (e.target === modalOverlay) closeProductModal();
});

// Quantity in modal
modalQtyDec.addEventListener('click', () => {
if (modalCurrentQty > 1) modalCurrentQty--;
modalQtyVal.textContent = modalCurrentQty;
});
modalQtyInc.addEventListener('click', () => {
modalCurrentQty++;
modalQtyVal.textContent = modalCurrentQty;
});

// Add to cart from modal
modalAddBtn.addEventListener('click', function() {
const id = modalCurrentProductId;
if (!id) return;
const qty = modalCurrentQty;
const ex = cart.find(i => i.id === id);
if (ex) ex.qty += qty;
else cart.push({id, qty});
renderCart();
closeProductModal();
showToast(`Added ${qty} item(s) to cart 🌿`);
});

// ============ CARD / QUICK VIEW CLICK ============
document.addEventListener('click', (e) => {
if (e.target.closest('.quick-view')) {
const qv = e.target.closest('.quick-view');
const id = parseInt(qv.dataset.id);
if (!isNaN(id)) { e.preventDefault(); openProductModal(id); }
return;
}
const card = e.target.closest('.card');
if (card && !e.target.closest('.add-btn') && !e.target.closest('.wish') && !e.target.closest('.card-title a')) {
const id = parseInt(card.dataset.id);
if (!isNaN(id)) openProductModal(id);
}
});

// ============ CAROUSEL ============
const categories = [
{key:'caps', label:'Caps (Free Size)', products: products.filter(p=>p.cat==='caps')},
{key:'bags', label:'School Bags', products: products.filter(p=>p.cat==='bags')},
{key:'tote', label:'Tote Bags (14×16)', products: products.filter(p=>p.cat==='tote')},
{key:'tshirt', label:'T-Shirts (S–XXL)', products: products.filter(p=>p.cat==='tshirt')}
];
let currentSlide = 0;
const track = document.getElementById('carouselTrack');
const dots = document.getElementById('carouselDots');
function renderCarousel(){
track.innerHTML = categories.map(cat => `<div class="carousel-slide">
<div class="slide-label">${cat.label}</div>
<div class="grid">${cat.products.map(productCard).join('')}</div>
</div>`).join('');
dots.innerHTML = categories.map((c,i)=>`<span class="dot ${i===currentSlide?'active':''}" data-index="${i}"></span>`).join('');
track.style.transform = `translateX(-${currentSlide * 100}%)`;
document.querySelectorAll('.carousel-slide .card').forEach((card, i) => {
setTimeout(() => card.classList.add('visible'), i * 50);
});
}
function goToSlide(index){
currentSlide = Math.max(0, Math.min(index, categories.length - 1));
track.style.transform = `translateX(-${currentSlide * 100}%)`;
document.querySelectorAll('.carousel-dots .dot').forEach((d,i) => d.classList.toggle('active', i===currentSlide));
}
document.getElementById('carouselPrev').addEventListener('click', ()=>goToSlide(currentSlide-1));
document.getElementById('carouselNext').addEventListener('click', ()=>goToSlide(currentSlide+1));
dots.addEventListener('click', (e)=>{
const dot = e.target.closest('.dot');
if(dot) goToSlide(parseInt(dot.dataset.index));
});
let startX = 0, isDragging = false;
track.addEventListener('touchstart', (e)=>{ startX = e.touches[0].clientX; isDragging = true; });
track.addEventListener('touchmove', (e)=>{
if(!isDragging) return;
const diff = startX - e.touches[0].clientX;
if(Math.abs(diff) > 50){
if(diff > 0) goToSlide(currentSlide+1); else goToSlide(currentSlide-1);
isDragging = false;
}
});
track.addEventListener('touchend', ()=>{isDragging = false});
renderCarousel();

// ============ FIXED FILTER PILLS (Carousel Navigation) ============
const filterMap = {
'all': 0,
'caps': 0,
'bags': 1,
'tote': 2,
'tshirt': 3,
'premium': 0
};
document.querySelectorAll('.pill').forEach(pill => {
pill.addEventListener('click', () => {
document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
pill.classList.add('active');
const filter = pill.dataset.filter;
const index = filterMap[filter] !== undefined ? filterMap[filter] : 0;
goToSlide(index);
});
});

// ============ OTHER GRIDS ============
document.getElementById('bestGrid').innerHTML=[products[1],products[3],products[9],products[12],products[24]].map(productCard).join('');
document.getElementById('newGrid').innerHTML=products.filter(p=>p.badge==='new').slice(0,6).map(productCard).join('');
document.querySelectorAll('.grid .card').forEach((card, i) => {
setTimeout(() => card.classList.add('visible'), i * 50);
});
// ============ WISHLIST ============
document.addEventListener('click',e=>{
if(e.target.closest('.wish')){
const b=e.target.closest('.wish');
b.classList.toggle('active');
showToast(b.classList.contains('active')?'Added to wishlist 💖':'Removed from wishlist');
}
});
// ============ CART ============
let cart=JSON.parse(localStorage.getItem('vog-cart')||'[]');
cart = cart.filter(i => products.some(p => p.id === i.id));
const cartSide=document.getElementById('cartSide');
const cartOverlay=document.getElementById('cartOverlay');
const cartItemsEl=document.getElementById('cartItems');
const cartCountEl=document.getElementById('cartCount');
const cartTotalEl=document.getElementById('cartTotal');

function openCart(){cartSide.classList.add('open');cartOverlay.classList.add('open');document.body.classList.add('cart-open')}
function closeCart(){cartSide.classList.remove('open');cartOverlay.classList.remove('open');document.body.classList.remove('cart-open')}
document.getElementById('cartToggle').addEventListener('click',openCart);
document.getElementById('cartClose').addEventListener('click',closeCart);
cartOverlay.addEventListener('click',closeCart);
// ============ COUPON ============
const coupons = {'GHEERA10': { discount: 10, type: 'percent' }};
let appliedCoupon = null, couponDiscount = 0;
document.getElementById('applyCoupon').addEventListener('click', function() {
const input = document.getElementById('couponInput');
const msg = document.getElementById('couponMessage');
const code = input.value.trim().toUpperCase();
if (!code) { msg.textContent = 'Please enter a coupon code'; msg.className = 'coupon-error'; return; }
if (coupons[code]) {
appliedCoupon = code;
couponDiscount = coupons[code].discount;
msg.textContent = `✅ ${couponDiscount}% discount applied!`;
msg.className = 'coupon-applied';
input.style.borderColor = 'var(--olive)';
renderCart();
} else {
msg.textContent = '❌ Invalid coupon code';
msg.className = 'coupon-error';
input.style.borderColor = '#c44';
}
});

function renderCart(){
if(cart.length===0){
cartItemsEl.innerHTML=`<div class="cart-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg><p>Your cart is empty</p><small>Add some elegance to your day 🌿</small></div>`;
} else {
cartItemsEl.innerHTML=cart.map(item=>{
const p=products.find(x=>x.id===item.id);
return `<div class="cart-item">
<div class="cart-thumb"><img src="${p.image}" alt="${p.title}" loading="lazy" decoding="async"></div>
<div class="cart-info">
<h4>${p.title}</h4>
<div class="price">₹${(p.price*item.qty).toFixed(0)}</div>
<div class="qty-ctrl">
<button onclick="updateQty(${p.id},-1)">−</button><span>${item.qty}</span><button onclick="updateQty(${p.id},1)">+</button>
</div>
</div>
<button class="cart-rm" onclick="removeItem(${p.id})">Remove</button>
</div>`;
}).join('');
}
let total = cart.reduce((s,i)=>s+products.find(p=>p.id===i.id).price*i.qty,0);
let discountAmt = 0;
if(appliedCoupon && coupons[appliedCoupon]){ discountAmt = (total * coupons[appliedCoupon].discount) / 100; }
let finalTotal = total - discountAmt;
if(cart.length===0){ appliedCoupon = null; couponDiscount = 0; finalTotal = 0; }
let totalHTML = `<span>₹${Math.round(finalTotal)}</span>`;
if(discountAmt > 0){
let extras = [];
if(discountAmt > 0) extras.push(`discount −₹${Math.round(discountAmt)}`);
totalHTML = `<div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;">
<span style="text-decoration:line-through;color:var(--muted);font-size:14px;">₹${Math.round(total)}</span>
${extras.map(e => `<span style="font-size:12px;color:var(--muted);">${e}</span>`).join('')}
<span style="color:var(--olive-dark);font-weight:700;">₹${Math.round(finalTotal)}</span>
</div>`;
}
cartTotalEl.innerHTML = totalHTML;
cartCountEl.textContent = cart.reduce((s,i)=>s+i.qty,0);
localStorage.setItem('vog-cart',JSON.stringify(cart));
}
function updateQty(id,delta){
const it=cart.find(i=>i.id===id);
if(!it)return;
it.qty+=delta;
if(it.qty<=0)cart=cart.filter(i=>i.id!==id);
renderCart();
}
function removeItem(id){cart=cart.filter(i=>i.id!==id);renderCart();showToast('Removed from cart')}
document.addEventListener('click',e=>{
if(e.target.closest('.add-btn') && !e.target.closest('.product-modal') ){
const id=parseInt(e.target.closest('.add-btn').dataset.id);
const ex=cart.find(i=>i.id===id);
if(ex)ex.qty++;else cart.push({id,qty:1});
renderCart();openCart();showToast('Added to cart 🌿');
}
});
renderCart();
// ============ SEARCH ============
document.getElementById('searchInput').addEventListener('input', function(){
const q = this.value.trim().toLowerCase();
document.querySelectorAll('.card').forEach(card=>{
const p = products.find(x=>x.id===parseInt(card.dataset.id));
if(!p) return;
const hit = !q || p.title.toLowerCase().includes(q) || (p.arabic||'').includes(q) || catLabel(p.cat).toLowerCase().includes(q);
card.style.display = hit ? '' : 'none';
});
});
// ============ TOAST ============
let toastTimer = null;
function showToast(msg) {
const t = document.getElementById('toast');
if (toastTimer) { clearTimeout(toastTimer); toastTimer = null; }
t.classList.remove('show');
void t.offsetWidth;
t.textContent = msg;
t.classList.add('show');
toastTimer = setTimeout(() => { t.classList.remove('show'); toastTimer = null; }, 2000);
}
document.getElementById('toast').addEventListener('click', function() {
this.classList.remove('show');
if (toastTimer) { clearTimeout(toastTimer); toastTimer = null; }
});
// ============ CHECKOUT + ADDRESS FORM + RAZORPAY ============
const SHEET_URL = 'https://script.google.com/macros/s/AKfycbwjNbYPujxUBwgC4dANRQc614d2SC2ll3epY-XY8oyo-FhkqJYhABDkUUWWvr9fAGSRMw/exec';
const addrOverlay = document.getElementById('addrOverlay');
const addrForm = document.getElementById('addrForm');
const addrErr = document.getElementById('addrErr');
const addrSubmit = document.getElementById('addrSubmit');
let pendingOrder = null;

function cartTotalAmount(){
let total = cart.reduce((s, i) => s + products.find(p => p.id === i.id).price * i.qty, 0);
if(appliedCoupon && coupons[appliedCoupon]){ total = total - (total * coupons[appliedCoupon].discount) / 100; }
return Math.round(total);
}
function sendToSheet(payload){
try{
fetch(SHEET_URL, {
method: 'POST',
mode: 'no-cors',
headers: { 'Content-Type': 'text/plain;charset=utf-8' },
body: JSON.stringify(payload)
}).catch(function(){});
}catch(e){}
}
function startCheckout() {
if (cart.length === 0) { showToast('Your cart is empty'); return; }
if (typeof Razorpay === 'undefined') { showToast('Payment system loading... Please try again in a moment'); return; }
addrErr.textContent = '';
addrOverlay.classList.add('open');
document.body.style.overflow = 'hidden';
setTimeout(function(){ document.getElementById('afName').focus(); }, 100);
}
function closeAddr(){ addrOverlay.classList.remove('open'); document.body.style.overflow = ''; }
document.getElementById('addrCancel').addEventListener('click', closeAddr);
addrOverlay.addEventListener('click', function(e){ if(e.target === addrOverlay) closeAddr(); });

addrForm.addEventListener('submit', function(e){
e.preventDefault();
const v = id => document.getElementById(id).value.trim();
const customerName = v('afName'), mobile = v('afMobile'), address = v('afAddress');
const city = v('afCity'), state = v('afState'), pinCode = v('afPin'), landmark = v('afLandmark');
if(!customerName){ addrErr.textContent = 'Please enter your full name'; return; }
if(!/^[6-9]\d{9}$/.test(mobile)){ addrErr.textContent = 'Please enter a valid 10-digit mobile number'; return; }
if(address.length < 10){ addrErr.textContent = 'Please enter your complete address'; return; }
if(!city){ addrErr.textContent = 'Please enter your city'; return; }
if(!state){ addrErr.textContent = 'Please enter your state'; return; }
if(!/^\d{6}$/.test(pinCode)){ addrErr.textContent = 'Please enter a valid 6-digit pin code'; return; }
if (cart.length === 0) { addrErr.textContent = 'Your cart is empty'; return; }
addrErr.textContent = '';
const productList = cart.map(i => { const p = products.find(x => x.id === i.id); return p.title + ' x' + i.qty; }).join(', ');
const quantity = cart.reduce((s,i)=>s+i.qty,0);
const amount = cartTotalAmount();
const orderId = 'VOG' + Date.now();
pendingOrder = { orderId: orderId, customerName: customerName, mobile: mobile, address: address, city: city, state: state, pinCode: pinCode, landmark: landmark, product: productList, quantity: quantity, amount: amount, paymentId: '', paymentStatus: 'Pending' };
sendToSheet(pendingOrder);
closeAddr();
openRazorpay(pendingOrder);
});

function openRazorpay(order){
const btn = document.getElementById('checkoutBtn');
const prev = btn.textContent;
btn.disabled = true;
btn.textContent = 'Processing…';
const options = {
key: 'rzp_live_TYLViBrVuuLaZv',
amount: order.amount * 100, currency: 'INR',
name: 'Vail of Gheera', description: 'Modesty with Purpose',
image: 'data:image/webp;base64,',
prefill: { name: order.customerName, email: '', contact: order.mobile },
notes: { orderId: order.orderId, address: order.address + ', ' + order.city + ', ' + order.state + ' - ' + order.pinCode },
theme: { color: '#d4878a' },
handler: function(response) {
sendToSheet(Object.assign({}, order, { paymentId: response.razorpay_payment_id || '', paymentStatus: 'Success' }));
cart = []; appliedCoupon = null; couponDiscount = 0;
renderCart(); closeCart();
addrForm.reset();
showToast('✅ Payment successful — JazakAllahu khairan! 🌿');
btn.disabled = false; btn.textContent = prev;
},
modal: { ondismiss: function() {
showToast('Payment cancelled');
btn.disabled = false; btn.textContent = prev;
}}
};
const rzp = new Razorpay(options);
rzp.on('payment.failed', function(response) {
sendToSheet(Object.assign({}, order, { paymentId: (response.error && response.error.metadata && response.error.metadata.payment_id) || '', paymentStatus: 'Failed' }));
showToast('Payment failed: ' + ((response.error && response.error.description) || 'Please try again'));
btn.disabled = false; btn.textContent = prev;
});
rzp.open();
}
document.getElementById('checkoutBtn').addEventListener('click', startCheckout);
// ============ FAQ ============
document.querySelectorAll('.faq-q').forEach(q=>{
q.addEventListener('click',()=>q.parentElement.classList.toggle('open'));
});
document.getElementById('mobileBack').addEventListener('click',()=>document.getElementById('mobileMenu').classList.remove('open'));
// ============ SCROLL REVEAL ============
const io=new IntersectionObserver(entries=>{
entries.forEach(e=>{
if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
});
},{threshold:0.08});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
document.querySelectorAll('.card').forEach((card, i) => {
setTimeout(() => card.classList.add('visible'), i * 50);
});
</script>
