<style>
*,::before,::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font-family:'Poppins',sans-serif;background:var(--bg);color:var(--text);line-height:1.6;overflow-x:hidden;transition:background var(--transition),color var(--transition)}
:root{
--bg:#faf6ef; --ivory:#f5efe4; --sand:#e8dcc4; --beige:#d9c9a8;
--olive:#6b7a4a; --olive-dark:#4f5c34; --gold:#c9a961; --gold-soft:#e0c88a;
--pink:#d4878a; --pink-soft:#f0d4d5; --pink-light:#fce8e9;
--black:#1a1a1a; --charcoal:#2b2b2b; --muted:#7a6f5c; --text:#2b2622;
--card:rgba(255,255,255,0.55); --border:rgba(180,160,120,0.25);
--shadow:0 10px 40px rgba(107,122,74,0.12); --shadow-lg:0 20px 60px rgba(107,122,74,0.18);
--radius:22px; --radius-sm:14px; --transition:0.4s cubic-bezier(.2,.8,.2,1);
}
[data-theme="dark"]{
--bg:#141210; --ivory:#1e1b18; --sand:#2a2521; --beige:#3a332a;
--olive:#a3b076; --olive-dark:#c4cf9a; --gold:#d9b978; --gold-soft:#ecd7a0;
--pink:#d4878a; --pink-soft:#5a3a3b; --pink-light:#3a2829;
--black:#f5efe4; --charcoal:#e8dcc4; --muted:#a89a80; --text:#f0e8d8;
--card:rgba(40,35,30,0.55); --border:rgba(217,185,120,0.18);
--shadow:0 10px 40px rgba(0,0,0,0.4); --shadow-lg:0 20px 60px rgba(0,0,0,0.55);
}
h1,h2,h3,h4{font-family:'Playfair Display',serif;font-weight:600;letter-spacing:-0.02em;color:var(--black);word-break:break-word}
.arabic{font-family:'Amiri',serif;direction:rtl}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
.container{max-width:1280px;margin:0 auto;padding:0 24px}
.pattern-bg{position:fixed;inset:0;z-index:-1;opacity:0.06;pointer-events:none;background-image:radial-gradient(circle at 20% 30%, var(--olive) 1px, transparent 1px),radial-gradient(circle at 80% 70%, var(--pink) 1px, transparent 1px);background-size:60px 60px,80px 80px}
.pattern-bg::before{content:"";position:absolute;inset:0;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120' viewBox='0 0 120 120'><g fill='none' stroke='%23d4878a' stroke-width='0.6' opacity='0.5'><polygon points='60,10 90,30 90,70 60,90 30,70 30,30'/><polygon points='60,25 78,37 78,63 60,75 42,63 42,37'/><circle cx='60' cy='60' r='6'/></g></svg>");opacity:0.6}
#preloader{position:fixed;inset:0;background:var(--bg);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity 0.8s ease,visibility 0.8s ease}
#preloader.hide{opacity:0;visibility:hidden}
.loader-logo{animation:pulse 1.5s ease-in-out infinite}
.loader-logo img{width:120px;height:120px;object-fit:contain;border-radius:50%;box-shadow:0 10px 40px rgba(107,122,74,0.2)}
@keyframes pulse{0%,100%{opacity:0.7;transform:scale(1)}50%{opacity:1;transform:scale(1.05)}}
.nav{position:sticky;top:0;z-index:100;backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);background:color-mix(in oklab,var(--bg) 75%,transparent);border-bottom:1px solid var(--border);transition:all var(--transition)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;padding:18px 24px;max-width:1400px;margin:0 auto}
.hamburger{order:-1;margin-right:10px}
.logo{display:flex;align-items:center;gap:0px}
.logo-mark{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--olive),var(--pink));display:grid;place-items:center;box-shadow:var(--shadow);overflow:hidden}
.logo-mark img{width:100%;height:100%;object-fit:contain;padding:4px;background:#fff;border-radius:50%}
.nav-links{display:flex;gap:32px;align-items:center}
.nav-links a{font-size:14px;font-weight:500;color:var(--text);position:relative;padding:6px 0;transition:color var(--transition)}
.nav-links a::after{content:"";position:absolute;bottom:0;left:0;right:0;height:1px;background:var(--pink);transform:scaleX(0);transform-origin:right;transition:transform var(--transition)}
.nav-links a:hover{color:var(--olive-dark)}
.nav-links a:hover::after{transform:scaleX(1);transform-origin:left}
.nav-actions{display:flex;gap:14px;align-items:center}
.icon-btn{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:var(--card);border:1px solid var(--border);transition:all var(--transition);position:relative}
.icon-btn:hover{background:var(--pink-light);transform:translateY(-2px);box-shadow:var(--shadow)}
.icon-btn svg{width:18px;height:18px;stroke:var(--text);fill:none;stroke-width:1.8}
.cart-count{position:absolute;top:-4px;right:-4px;background:var(--pink);color:#fff;font-size:10px;font-weight:600;min-width:18px;height:18px;padding:0 5px;border-radius:9px;display:grid;place-items:center}
.hamburger{display:grid}
.search-wrap{display:none;padding:0 24px 16px}
.search-wrap.active{display:block;animation:fadeDown 0.3s ease}
.search-input{width:100%;max-width:1280px;margin:0 auto;display:block;padding:14px 20px;border-radius:100px;border:1px solid var(--border);background:var(--card);font-family:inherit;font-size:14px;color:var(--text);outline:none;transition:all var(--transition)}
.search-input:focus{border-color:var(--pink);box-shadow:0 0 0 4px color-mix(in oklab,var(--pink) 15%,transparent)}
@keyframes fadeDown{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}
.hero{min-height:92vh;position:relative;display:flex;align-items:center;padding:60px 24px;overflow:hidden}
.hero-grid{max-width:1280px;margin:0 auto;width:100%;display:grid;grid-template-columns:1.1fr 0.9fr;gap:60px;align-items:center}
.hero-eyebrow{display:inline-flex;align-items:center;gap:10px;padding:8px 16px;border-radius:100px;background:var(--card);border:1px solid var(--border);font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:var(--pink);margin-bottom:24px;animation:fadeUp 0.8s ease both}
.hero-eyebrow::before{content:"✦";color:var(--gold);font-size:14px}
.hero h1{font-size:clamp(38px,6vw,80px);line-height:1.05;margin-bottom:24px;animation:fadeUp 1s ease both;animation-delay:0.1s}
.hero h1 em{font-style:italic;color:var(--pink);position:relative}
.hero h1 em::after{content:"";position:absolute;bottom:2px;left:0;right:0;height:8px;background:var(--pink-soft);opacity:0.4;z-index:-1;border-radius:8px}
.hero p.lead{font-size:17px;color:var(--muted);max-width:520px;margin-bottom:36px;animation:fadeUp 1s ease both;animation-delay:0.2s}
.hero-cta{display:flex;gap:16px;flex-wrap:wrap;animation:fadeUp 1s ease both;animation-delay:0.3s}
.btn{padding:16px 32px;border-radius:100px;font-weight:500;font-size:14px;letter-spacing:0.05em;transition:all var(--transition);display:inline-flex;align-items:center;gap:10px;text-transform:uppercase}
.btn-primary{background:linear-gradient(135deg,var(--olive),var(--pink));color:#fff;box-shadow:var(--shadow)}
.btn-primary:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg);background:linear-gradient(135deg,var(--olive-dark),var(--pink));color:#fff}
.btn-ghost{background:transparent;color:var(--black);border:1px solid var(--black)}
.btn-ghost:hover{background:var(--black);color:var(--bg)}
.hero-stats{display:flex;gap:40px;margin-top:56px;animation:fadeUp 1s ease both;animation-delay:0.4s}
.stat strong{font-family:'Playfair Display',serif;font-size:32px;color:var(--pink);display:block}
.stat span{font-size:12px;letter-spacing:0.15em;text-transform:uppercase;color:var(--muted)}
.hero-visual{position:relative;height:560px;animation:fadeIn 1.2s ease both;animation-delay:0.3s;overflow:hidden;border-radius:var(--radius)}
.hero-card{position:absolute;border-radius:var(--radius);overflow:hidden;background:var(--card);border:1px solid var(--border);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);box-shadow:var(--shadow-lg)}
.hero-card.main{inset:0;background:linear-gradient(135deg,#e8dcc4 0%,#f0d4d5 100%);display:flex;align-items:center;justify-content:center;animation:floaty 6s ease-in-out infinite}
.hero-card.main svg{width:70%;height:70%}
.hero-card.pill{bottom:30px;left:20px;padding:16px 22px;display:flex;gap:12px;align-items:center;animation:floaty 5s ease-in-out infinite;animation-delay:0.5s}
.hero-card.pill .dot{width:36px;height:36px;border-radius:50%;background:var(--pink);display:grid;place-items:center;color:#fff}
.hero-card.pill small{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.15em;display:block}
.hero-card.pill strong{font-family:'Playfair Display',serif;font-size:16px;color:var(--black)}
.hero-card.arabic-badge{top:20px;right:20px;padding:20px 24px;text-align:center;animation:floaty 7s ease-in-out infinite;animation-delay:1s}
.hero-card.arabic-badge .arabic{font-size:32px;color:var(--pink);line-height:1}
.hero-card.arabic-badge small{font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:var(--muted);margin-top:6px;display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-16px)}}
section{padding:100px 24px;position:relative}
.section-head{max-width:1280px;margin:0 auto 56px;text-align:center}
.section-eyebrow{font-size:12px;letter-spacing:0.3em;text-transform:uppercase;color:var(--pink);font-weight:600;margin-bottom:14px}
.section-head h2{font-size:clamp(32px,4vw,52px);margin-bottom:16px}
.section-head p{color:var(--muted);max-width:600px;margin:0 auto;font-size:16px}
.filter-row{max-width:1280px;margin:0 auto 40px;display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
.pill{padding:10px 22px;border-radius:100px;background:var(--card);border:1px solid var(--border);font-size:13px;font-weight:500;transition:all var(--transition);color:var(--text)}
.pill:hover{border-color:var(--pink)}
.pill.active{background:var(--pink);color:#fff;border-color:var(--pink)}
.grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:28px}
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;transition:all var(--transition);position:relative;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);opacity:0;transform:translateY(30px);cursor:pointer}
.card.visible{opacity:1;transform:translateY(0)}
.card:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg);border-color:var(--pink-soft)}
.card-media{position:relative;aspect-ratio:1;overflow:hidden;background:linear-gradient(135deg,var(--sand),var(--pink-light));display:grid;place-items:center}
.card-media img{width:100%;height:100%;object-fit:cover;transition:transform 0.6s ease}
.card:hover .card-media img{transform:scale(1.05)}
.card-media .arabic-overlay{position:absolute;font-family:'Amiri',serif;color:rgba(43,38,34,0.12);font-size:120px;line-height:1;pointer-events:none}
.badge{position:absolute;top:14px;left:14px;padding:5px 12px;border-radius:100px;font-size:10px;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;z-index:2}
.badge.sale{background:var(--pink);color:#fff}
.badge.new{background:var(--gold);color:#fff}
.wish{position:absolute;top:12px;right:12px;width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,0.9);display:grid;place-items:center;z-index:2;transition:all var(--transition)}
.wish svg{width:18px;height:18px;stroke:var(--charcoal);fill:none;stroke-width:1.8;transition:all var(--transition)}
.wish.active svg{fill:var(--pink);stroke:var(--pink)}
.wish:hover{transform:scale(1.1)}
.quick-view{position:absolute;bottom:0;left:0;right:0;padding:12px;background:var(--black);color:var(--bg);text-align:center;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;transform:translateY(100%);transition:transform var(--transition);cursor:pointer;z-index:3}
.card:hover .quick-view{transform:translateY(0)}
.card-body{padding:20px;pointer-events:none}
.card-body {pointer-events:auto}
.card-cat{font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:var(--pink);margin-bottom:6px}
.card-title{font-family:'Playfair Display',serif;font-size:18px;color:var(--black);margin-bottom:8px;line-height:1.3}
.card-title .arabic{font-size:22px;margin-right:6px;color:var(--olive-dark)}
.card-rating{display:flex;align-items:center;gap:4px;margin-bottom:12px;font-size:12px;color:var(--muted)}
.stars{color:var(--gold);letter-spacing:1px}
.card-foot{display:flex;justify-content:space-between;align-items:center;gap:12px}
.price{font-family:'Playfair Display',serif;font-size:20px;color:var(--black);font-weight:600}
.price s{color:var(--muted);font-size:14px;font-weight:400;margin-left:6px}
.add-btn{padding:10px 16px;background:linear-gradient(135deg,var(--olive),var(--pink));color:#fff;border-radius:100px;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;transition:all var(--transition);pointer-events:auto}
.add-btn:hover{background:var(--black);transform:scale(1.05)}
.cat-grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.cat-card{aspect-ratio:4/5;border-radius:var(--radius);overflow:hidden;position:relative;display:flex;align-items:flex-end;padding:32px;transition:all var(--transition);cursor:pointer}
.cat-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg)}
.cat-card::before{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.65),transparent 60%);z-index:1}
.cat-card.c1{background:linear-gradient(135deg,#6b7a4a,#4f5c34)}
.cat-card.c2{background:linear-gradient(135deg,#1a1a1a,#3a332a)}
.cat-card.c3{background:linear-gradient(135deg,#d9c9a8,#d4878a)}
.cat-card .arabic-deco{position:absolute;top:20px;right:20px;font-family:'Amiri',serif;font-size:80px;color:rgba(255,255,255,0.15);line-height:1}
.cat-content{position:relative;z-index:2;color:#fff}
.cat-content small{font-size:11px;letter-spacing:0.2em;text-transform:uppercase;opacity:0.85}
.cat-content h3{color:#fff;font-size:28px;margin:8px 0 12px}
.cat-content span{font-size:13px;display:inline-flex;align-items:center;gap:6px}
.cat-content span::after{content:"→";transition:transform var(--transition)}
.cat-card:hover .cat-content span::after{transform:translateX(6px)}
.about{background:linear-gradient(180deg,transparent,var(--ivory) 30%,var(--ivory) 70%,transparent)}
.about-grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
.about-visual{aspect-ratio:1;border-radius:var(--radius);background:linear-gradient(135deg,var(--olive) 0%,var(--pink) 100%);display:grid;place-items:center;position:relative;overflow:hidden;box-shadow:var(--shadow-lg)}
.about-visual::before{content:"";position:absolute;inset:20px;border:1px solid rgba(255,255,255,0.2);border-radius:calc(var(--radius) - 8px)}
.about-visual .arabic{font-size:120px;color:rgba(255,255,255,0.9);text-align:center}
.about-visual small{position:absolute;bottom:32px;color:rgba(255,255,255,0.7);letter-spacing:0.3em;font-size:11px;text-transform:uppercase}
.about-content h2{font-size:clamp(32px,4vw,48px);margin-bottom:24px}
.about-content p{color:var(--muted);margin-bottom:20px;font-size:16px}
.about-features{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:32px}
.about-feat{padding:20px;background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm)}
.about-feat strong{display:block;font-family:'Playfair Display',serif;font-size:24px;color:var(--pink)}
.about-feat span{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:0.1em}
.ig-grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(6,1fr);gap:12px}
.ig-tile{aspect-ratio:1;border-radius:var(--radius-sm);overflow:hidden;background:linear-gradient(135deg,var(--sand),var(--pink-light));display:grid;place-items:center;position:relative;cursor:pointer;transition:all var(--transition)}
.ig-tile:nth-child(2n){background:linear-gradient(135deg,var(--olive),var(--pink))}
.ig-tile:nth-child(3n){background:linear-gradient(135deg,var(--gold-soft),var(--pink))}
.ig-tile:nth-child(5n){background:linear-gradient(135deg,#2b2b2b,#1a1a1a)}
.ig-tile .arabic{font-family:'Amiri',serif;font-size:40px;color:rgba(255,255,255,0.6)}
.ig-tile:hover{transform:scale(1.05);z-index:2;box-shadow:var(--shadow-lg)}
.ig-tile::after{content:"❤";position:absolute;inset:0;background:rgba(0,0,0,0.5);color:#fff;display:grid;place-items:center;opacity:0;transition:opacity var(--transition);font-size:28px}
.ig-tile:hover::after{opacity:1}
.faq-wrap{max-width:820px;margin:0 auto}
.faq-item{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm);margin-bottom:14px;overflow:hidden;transition:all var(--transition)}
.faq-item.open{border-color:var(--pink);box-shadow:var(--shadow)}
.faq-q{padding:22px 26px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-weight:500;font-size:15px;color:var(--black);width:100%;text-align:left}
.faq-q::after{content:"+";font-size:24px;color:var(--pink);transition:transform var(--transition);font-weight:300}
.faq-item.open .faq-q::after{transform:rotate(45deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height 0.4s ease,padding 0.4s ease;padding:0 26px;color:var(--muted);font-size:14px}
.faq-item.open .faq-a{max-height:200px;padding:0 26px 22px}
.contact-grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px}
.contact-info h3{font-size:32px;margin-bottom:20px}
.contact-info p{color:var(--muted);margin-bottom:24px}
.contact-item{display:flex;gap:14px;align-items:center;margin-bottom:16px;font-size:14px}
.contact-item .ico{width:42px;height:42px;border-radius:50%;background:var(--pink-light);display:grid;place-items:center;color:var(--pink)}
.form{display:grid;gap:14px}
.form input,.form textarea{padding:16px 20px;border-radius:var(--radius-sm);border:1px solid var(--border);background:var(--card);font-family:inherit;font-size:14px;color:var(--text);outline:none;transition:all var(--transition)}
.form input:focus,.form textarea:focus{border-color:var(--pink);box-shadow:0 0 0 4px color-mix(in oklab,var(--pink) 12%,transparent)}
.form textarea{min-height:140px;resize:vertical}
.newsletter{max-width:900px;margin:0 auto;padding:60px;border-radius:var(--radius);background:linear-gradient(135deg,var(--olive-dark),var(--pink));color:#fff;text-align:center;box-shadow:var(--shadow-lg);position:relative;overflow:hidden}
.newsletter::before{content:"";position:absolute;inset:0;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100'><g fill='none' stroke='white' stroke-width='0.5' opacity='0.15'><polygon points='50,10 75,25 75,55 50,70 25,55 25,25'/></g></svg>");opacity:0.4}
.newsletter>*{position:relative;z-index:1}
.newsletter h3{color:#fff;font-size:36px;margin-bottom:12px}
.newsletter p{opacity:0.9;margin-bottom:28px}
.news-form{display:flex;gap:10px;max-width:480px;margin:0 auto;flex-wrap:wrap}
.news-form input{flex:1;min-width:220px;padding:16px 22px;border-radius:100px;border:none;font-family:inherit;font-size:14px;background:rgba(255,255,255,0.95);color:var(--text);outline:none}
.news-form button{padding:16px 30px;border-radius:100px;background:var(--black);color:#fff;font-weight:500;font-size:13px;letter-spacing:0.1em;text-transform:uppercase;transition:all var(--transition)}
.news-form button:hover{background:var(--gold);color:var(--black)}
.cart-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:200;opacity:0;visibility:hidden;transition:all var(--transition);backdrop-filter:blur(4px)}
.cart-overlay.open{opacity:1;visibility:visible}
.cart-side{position:fixed;top:0;right:0;bottom:0;width:min(420px,100%);background:var(--bg);z-index:201;transform:translateX(100%);transition:transform var(--transition);display:flex;flex-direction:column;box-shadow:-20px 0 60px rgba(0,0,0,0.15)}
.cart-side.open{transform:translateX(0)}
