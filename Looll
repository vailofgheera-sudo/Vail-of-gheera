mages:['data:image/webp;base64,','data:image/webp;base64,','data:image/webp;base64,']}];
products.forEach(p=>{ p.image = p.images[0]; });
const catLabel = c => c==='caps'?'Islamic Cap':c==='bags'?'School Bag':c==='tshirt'?'T-Shirt':'Tote Bag';
function productCard(p){
return `<article class="card" data-id="${p.id}" data-cat="${p.cat}" data-tag="${p.tag||''}">
${p.badge==='sale'?'<span class="badge sale">Sale</span>':''}${p.badge==='new'?'<span class="badge new">New</span>':''}
<button class="wish" data-id="${p.id}" aria-label="Wishlist"><svg viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg></button>
